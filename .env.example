# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/yashwant_farm?retryWrites=true&w=majority

# Admin Credentials (Set strong password in production)
ADMIN_EMAIL=admin@yashwantfarm.com
ADMIN_PASSWORD=YourStrongPasswordHere123!

# JWT Secret for Session Authentication
JWT_SECRET=generate_a_random_64_character_hex_or_string_here

# Frontend API URL (Set to your deployed backend URL on Render/Railway/Fly)
VITE_API_BASE_URL=https://your-backend-api.onrender.com
VITE_API_URL=https://your-backend-api.onrender.com
